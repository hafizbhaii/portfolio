s=\"loader-center\"><span id=\"load-number\" aria-hidden=\"true\">1</span><span class=\"loader-percent\" aria-hidden=\"true\">%</span></div><div class=\"loader-bottom\"><span>%%FIELD_f0010%%</span><button id=\"skip-intro\">%%FIELD_f0011%%</button></div><div class=\"loader-track\"><div id=\"load-bar\"></div></div></div>\n<script id=\"intro-controller\">(() => {\n  const intro = window.portfolioIntro;\n  if (!intro || !intro.active) return;\n  const root = document.documentElement;\n  const loader = document.getElementById('loader');\n  const number = document.getElementById('load-number');\n  const bar = document.getElementById('load-bar');\n  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');\n  const duration = 2800;\n  const fadeDuration = 750;\n  const start = performance.now();\n  let ready = document.readyState !== 'loading';\n  let ending = false;\n  let frame = 0;\n  let holdTimer = 0;\n  let fadeTimer = 0;\n  let lastValue = 1;\n  loader.hidden = false;\n  function setInert(value) {\n    document.querySelectorAll('.site-header, #main, .site-footer').forEach(el => el.inert = value);\n  }\n  function release() {\n    intro.active = false;\n    clearTimeout(intro.timeout);\n    clearTimeout(holdTimer);\n    clearTimeout(fadeTimer);\n    cancelAnimationFrame(frame);\n    const hadFocus = loader.contains(document.activeElement);\n    loader.hidden = true;\n    root.classList.remove('intro-pending', 'intro-exiting');\n    setInert(false);\n    if (hadFocus) document.querySelector('.wordmark')?.focus({preventScroll:true});\n  }\n  function finish(immediate = false) {\n    if (!intro.active) return;\n    if (immediate) { release(); return; }\n    if (ending) return;\n    ending = true;\n    number.textContent = '100';\n    bar.style.width = '100%';\n    holdTimer = setTimeout(() => {\n      if (!intro.active) return;\n      root.classList.add('intro-exiting');\n      root.classList.remove('intro-pending');\n      loader.classList.add('finished');\n      fadeTimer = setTimeout(release, fadeDuration);\n    }, 250);\n  }\n  function progress(now) {\n    if (!intro.active || ending) return;\n    const t = Math.min((now - start) / duration, 1);\n    const eased = t * t * (3 - 2 * t);\n    const value = Math.max(lastValue, Math.min(99, Math.round(1 + 98 * eased)));\n    // Hold just below completion until the document has been parsed.\n    lastValue = ready ? value : Math.min(value, 95);\n    number.textContent = String(lastValue);\n    bar.style.width = `${lastValue}%`;\n    if (t === 1 && ready) finish();\n    else frame = requestAnimationFrame(progress);\n  }\n  document.getElementById('skip-intro').addEventListener('click', () => finish(true));\n  const onMotionChange = event => { if (event.matches) finish(true); };\n  if (motion.addEventListener) motion.addEventListener('change', onMotionChange);\n  else motion.addListener(onMotionChange);\n  const onReady = () => {\n    ready = true;\n    if (intro.active) setInert(true);\n  };\n  if (ready) onReady();\n  else document.addEventListener('DOMContentLoaded', onReady, {once:true});\n  frame = requestAnimationFrame(progress);\n})();</script>\n<header class=\"site-header\"><a class=\"wordmark\" href=\"#top\" aria-label=\"%%FIELD_f0012%%\"><img src=\"%%FIELD_f0013%%\" width=\"38\" height=\"38\" alt=\"%%FIELD_f0014%%\"><span>%%FIELD_f0015%%<span class=\"wordmark-caption\">%%FIELD_f0016%%</span></span></a><nav class=\"desktop-nav\" aria-label=\"%%FIELD_f0017%%\"><a href=\"#work\">%%FIELD_f0018%%<sup>04</sup></a><a href=\"#about\">%%FIELD_f0019%%</a><a href=\"#services\">%%FIELD_f0020%%</a></nav><a href=\"#contact\" class=\"nav-cta\">%%FIELD_f0021%%<span aria-hidden=\"true\">↗</span></a><button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\" aria-label=\"Switch to dark mode\" aria-pressed=\"false\" title=\"Switch to dark mode\"><svg class=\"theme-moon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"