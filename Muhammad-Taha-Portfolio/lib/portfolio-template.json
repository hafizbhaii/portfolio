"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style id=\"intro-critical\">\nhtml.intro-pending,html.intro-exiting{overflow:hidden}\nhtml.intro-pending,html.intro-pending body{background:#0b3d73}\nhtml.intro-pending .site-header,html.intro-pending #main,html.intro-pending .site-footer{visibility:hidden}\nhtml.intro-pending #loader{display:flex!important}\n</style>\n<script id=\"intro-boot\">(() => {\n  const root = document.documentElement;\n  const active = !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !location.hash;\n  const intro = window.portfolioIntro = {active, timeout: 0};\n  if (!active) return;\n  root.classList.add('intro-pending');\n  // Always release the page if loading or another script fails.\n  intro.timeout = setTimeout(() => {\n    intro.active = false;\n    root.classList.remove('intro-pending', 'intro-exiting');\n    const loader = document.getElementById('loader');\n    if (loader) loader.hidden = true;\n    document.querySelectorAll('.site-header, #main, .site-footer').forEach(el => el.inert = false);\n  }, 8000);\n})();</script>\n<title>%%FIELD_f0001%%&%%FIELD_f0002%%</title>\n<meta name=\"description\" content=\"%%FIELD_f0003%%\">\n<meta name=\"theme-color\" content=\"#f4f4f0\"><meta name=\"color-scheme\" content=\"light dark\">\n<meta property=\"og:title\" content=\"%%FIELD_f0004%%\"><meta property=\"og:description\" content=\"%%FIELD_f0005%%\"><meta property=\"og:type\" content=\"website\">\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='9' fill='%230b3d73'/%3E%3Ctext x='20' y='27' text-anchor='middle' font-family='Arial' font-weight='700' font-size='23' fill='white'%3Emt%3C/text%3E%3C/svg%3E\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;650;700;800&display=swap\" rel=\"stylesheet\">\n<script id=\"theme-controller\">\n(() => {\n  'use strict';\n  const key = 'taha-portfolio-theme';\n  const root = document.documentElement;\n  const system = window.matchMedia('(prefers-color-scheme: dark)');\n  let choice = null;\n  try {\n    const saved = localStorage.getItem(key);\n    if (saved === 'light' || saved === 'dark') choice = saved;\n  } catch (_) { /* The toggle also works when browser storage is unavailable. */ }\n  function applyTheme() {\n    const theme = choice || (system.matches ? 'dark' : 'light');\n    root.dataset.theme = theme;\n    const meta = document.querySelector('meta[name=\"theme-color\"]');\n    if (meta) meta.content = theme === 'dark' ? '#0d121a' : '#f4f4f0';\n    const button = document.getElementById('theme-toggle');\n    if (button) {\n      const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';\n      button.setAttribute('aria-label', label);\n      button.setAttribute('aria-pressed', String(theme === 'dark'));\n      button.title = label;\n    }\n  }\n  applyTheme();\n  const onSystemChange = () => { if (choice === null) applyTheme(); };\n  if (system.addEventListener) system.addEventListener('change', onSystemChange);\n  else system.addListener(onSystemChange);\n  document.addEventListener('DOMContentLoaded', () => {\n    applyTheme();\n    document.getElementById('theme-toggle').addEventListener('click', () => {\n      choice = root.dataset.theme === 'dark' ? 'light' : 'dark';\n      try { localStorage.setItem(key, choice); } catch (_) {}\n      applyTheme();\n    });\n  }, {once:true});\n})();\n</script>\n<style>\n:root{--paper:#f4f4f0;--ink:#191a1e;--muted:#66686d;--line:#d7d8d4;--blue:#0b3d73;--yellow:#ffdf5d;--white:#fff;--font:'DM Sans',Arial,sans-serif;--heading:'Manrope',Arial,sans-serif}\n*{box-sizing:bord